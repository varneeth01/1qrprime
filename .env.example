NODE_ENV=development
PORT=3001
DATABASE_DRIVER=sqlite
# Paths are relative to API working directory when using npm scripts
DATABASE_PATH=./data/prime.sqlite
MEDIA_ROOT=./data/uploads
# Required for staging/production. Production never falls back to SQLite.
DATABASE_URL=
DIRECT_URL=
# Customer-facing origin. Localhost is local-only; shared/staging QR must use HTTPS.
PUBLIC_ORIGIN=http://localhost:5173
# Leave unset for the supported same-origin preview proxy. Set only for a separately deployed API.
API_PUBLIC_ORIGIN=
ADMIN_ORIGIN=http://localhost:5173
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Production mandatory; inject from secret manager, never commit values
SUPPORT_EMAIL=
SMTP_URL=
MAIL_FROM=
# Optional image storage (credentials through standard AWS secret environment/IAM role)
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_ORIGIN=
# SMTP_URL is supported for existing deployments. Prefer the explicit fields below.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=1QR Prime
SMTP_FROM_EMAIL=
# Optional authenticated Expo push; APNs/FCM configured in EAS
EXPO_ACCESS_TOKEN=
# Razorpay credentials are injected into the API only. Never expose the secret to web/mobile builds.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
