EXPO_PUBLIC_ENVIRONMENT=preview
EXPO_PUBLIC_API_URL=https://your-preview-host/api
# Legacy alias accepted for local compatibility; prefer EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_API_ORIGIN=https://your-operated-api-domain
EXPO_PUBLIC_WEB_ORIGIN=https://your-operated-web-domain
EAS_PROJECT_ID=
# Only for local debug prebuild; production does not allow cleartext traffic
APP_VARIANT=development

# Production builds:
# EXPO_PUBLIC_ENVIRONMENT=production
# EXPO_PUBLIC_API_URL=https://api.1qrprime.com/api
# EXPO_PUBLIC_WEB_ORIGIN=https://1qrprime.com
